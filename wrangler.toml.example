name = "disposable-email-worker"
main = "src/index.ts"
compatibility_date = "2025-04-01"

# Custom domain — routes HTTP traffic to this Worker.
# Requires a proxied DNS record (A or CNAME) for the base domain.
# routes = [{ pattern = "drop.example.com/*", zone_name = "example.com" }]

# D1 database binding — actual database_id set per environment
[[d1_databases]]
binding = "DB"
database_name = "disposable-email-db"
database_id = ""  # Set via: pulumi -C infra stack output databaseId

# Send Email binding — used to forward with rewritten headers.
# message.forward() only allows X-* headers; SEB allows full MIME control.
[[send_email]]
name = "SEB"

# Email routing — Worker receives inbound email via exported `email` handler
# Catch-all configured via Pulumi after first deploy

# Environment variables (non-secret)
[vars]
BASE_DOMAIN = ""          # e.g. "drop.example.com"
ADMIN_USERS = ""          # e.g. "alice@example.com,bob@example.com"
CF_ACCESS_TEAM = ""       # Cloudflare Access team name (e.g. "myteam")
CF_ACCESS_AUD = ""        # Access application audience tag (from Access app settings)

# Secrets (set via `wrangler secret put`):
# - CLOUDFLARE_API_TOKEN (only if CNAME wildcard fails)
# - CLOUDFLARE_ZONE_ID (only if CNAME wildcard fails)
